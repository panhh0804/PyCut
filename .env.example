# auto prefers the live model and falls back to the deterministic π planner.
# local never calls a remote model; remote fails if the remote model is unavailable.
PICUT_AGENT_MODE=auto
PICUT_MODEL_PROVIDER=siliconflow
PICUT_MODEL_BASE_URL=https://api.siliconflow.cn/v1
PICUT_MODEL_ID=moonshotai/Kimi-K2.7-Code
PICUT_MODEL_FALLBACK_IDS=deepseek-ai/DeepSeek-V4-Pro,deepseek-ai/DeepSeek-V4-Flash
PICUT_MODEL_API_KEY_FILE=.picut/secrets/model-api-key

# Optional explicit Chrome path used by Remotion rendering.
PICUT_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
