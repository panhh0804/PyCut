# Native Pi AgentSession reads provider/model/thinking/auth from the user's
# existing Pi settings. πCut does not define a second model or fallback stack.

# SiliconFlow is used only by the optional narration/TTS service.
PICUT_MODEL_BASE_URL=https://api.siliconflow.cn/v1
PICUT_MODEL_API_KEY_FILE=.picut/secrets/model-api-key

# Optional. Resolution order is: Pi httpProxy → this value → process proxy
# environment → macOS system proxy → direct connection.
# PICUT_HTTP_PROXY=http://127.0.0.1:7897

# Optional explicit Chrome path used by Remotion rendering.
PICUT_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
